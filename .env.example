# The secret key used for signing sessions and tokens
SECRET_KEY=django-insecure-ibsjbhz&kkkot0b751u1*wjo@2pn9cpd&=y!ou0f!e_csxs&1x

# Whether to enable debug mode
DEBUG=true

# The hosts to allow access from
